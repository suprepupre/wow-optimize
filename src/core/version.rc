#include <winver.h>

// The numbers come from version.h and are not written here. They used to be,
// and they went stale: this file said 3.18.2 through the whole of 3.19.0 and
// into 3.19.1, so every shipped DLL reported a version two releases behind what
// its own banner printed. Bumping a release touched four places and this was the
// fifth, which is why nobody noticed.
//
// version.h stops at #ifndef RC_INVOKED before anything the resource compiler
// cannot parse, so including it here is safe.
#include "version.h"

VS_VERSION_INFO VERSIONINFO
FILEVERSION     WOW_OPTIMIZE_VERSION_MAJOR,WOW_OPTIMIZE_VERSION_MINOR,WOW_OPTIMIZE_VERSION_PATCH,WOW_OPTIMIZE_VERSION_BUILD
PRODUCTVERSION  WOW_OPTIMIZE_VERSION_MAJOR,WOW_OPTIMIZE_VERSION_MINOR,WOW_OPTIMIZE_VERSION_PATCH,WOW_OPTIMIZE_VERSION_BUILD
FILEFLAGSMASK   VS_FFI_FILEFLAGSMASK
FILEFLAGS       0
FILEOS          VOS__WINDOWS32
FILETYPE        VFT_DLL
FILESUBTYPE     VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName",      "Suprematist"
            VALUE "FileDescription",  "WoW Performance Optimizer DLL"
            VALUE "FileVersion",      WOW_OPTIMIZE_VERSION_STR
            VALUE "InternalName",     "wow_optimize"
            VALUE "LegalCopyright",   "MIT License"
            VALUE "OriginalFilename", "wow_optimize.dll"
            VALUE "ProductName",      "wow_optimize"
            VALUE "ProductVersion",   WOW_OPTIMIZE_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
